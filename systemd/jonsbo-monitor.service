[Unit]
Description=Jonsbo TF3 Display Monitor (renders dashboard, talks to jonsbo-fan-daemon)
After=graphical-session.target jonsbo-fan-daemon.service
Wants=jonsbo-fan-daemon.service

[Service]
WorkingDirectory=%h/jonsbo-tf3-linux-driver
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/jonsbo-tf3-linux-driver/.venv/bin/python3 %h/jonsbo-tf3-linux-driver/jonsbo_monitor.py
# Safe to restart freely - this process never claims fan-panel USB
# interfaces directly, only jonsbo-fan-daemon.service does. See README.md.
Restart=no

[Install]
WantedBy=default.target
