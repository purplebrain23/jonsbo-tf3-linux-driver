[Unit]
Description=Jonsbo TF3 Fan-Panel USB Daemon (keeps the 3 fan panels claimed permanently)
After=graphical-session.target

[Service]
WorkingDirectory=%h/jonsbo-tf3-linux-driver
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/jonsbo-tf3-linux-driver/.venv/bin/python3 %h/jonsbo-tf3-linux-driver/jonsbo_fan_daemon.py
# Deliberately not on-failure: a crash-triggered auto-restart re-claims the
# USB interfaces, which reliably wedges the panels on this hardware (only a
# full physical power cycle recovers it). Restart manually after checking
# the panels aren't already wedged. See README.md.
Restart=no

[Install]
WantedBy=default.target
